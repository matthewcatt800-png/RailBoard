<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp"
    android:paddingTop="28dp" android:paddingBottom="12dp">

    <TextView
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="RailBoard" android:textSize="34sp" android:textStyle="bold"
        android:textColor="@color/m3_on_surface"/>
    <TextView
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Live UK train departures" android:textSize="14sp"
        android:textColor="@color/m3_on_surface_variant" android:layout_marginTop="2dp"/>

    <Button android:id="@+id/btnLast"
        android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="20dp"
        android:text="Open last station" android:textAllCaps="false" android:textSize="15sp" android:textStyle="bold"
        android:background="@drawable/btn_primary" android:textColor="@color/m3_on_primary"
        android:foreground="?android:attr/selectableItemBackground"/>

    <Button android:id="@+id/btnLocation"
        android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp"
        android:text="Find my nearest station" android:textAllCaps="false" android:textSize="15sp" android:textStyle="bold"
        android:background="@drawable/btn_secondary" android:textColor="@color/m3_on_secondary_container"
        android:foreground="?android:attr/selectableItemBackground"/>

    <EditText android:id="@+id/searchBox"
        android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="16dp"
        android:hint="Search stations" android:textSize="15sp" android:inputType="text"
        android:background="@drawable/edit_bg" android:paddingStart="16dp" android:paddingEnd="16dp"
        android:textColor="@color/m3_on_surface" android:textColorHint="@color/m3_outline"/>

    <TextView
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Stations" android:textSize="12sp" android:textStyle="bold"
        android:letterSpacing="0.12" android:textColor="@color/m3_on_surface_variant"
        android:layout_marginTop="20dp" android:layout_marginBottom="6dp"/>
</LinearLayout>