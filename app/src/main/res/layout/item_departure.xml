<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingBottom="8dp">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="14dp" android:background="@drawable/card_bg">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView android:id="@+id/depTime" android:layout_width="70dp" android:layout_height="wrap_content"
                android:textSize="18sp" android:textStyle="bold" android:textColor="@color/m3_on_surface"/>
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView android:id="@+id/depDest" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="15sp" android:textColor="@color/m3_on_surface"/>
                <TextView android:id="@+id/depOperator" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="11sp" android:textColor="@color/m3_on_surface_variant" android:layout_marginTop="2dp"/>
            </LinearLayout>
            <TextView android:id="@+id/depExpected" android:layout_width="80dp" android:layout_height="wrap_content"
                android:textSize="13sp" android:gravity="end"/>
            <TextView android:id="@+id/depPlatform" android:layout_width="64dp" android:layout_height="wrap_content"
                android:textSize="13sp" android:textColor="@color/m3_on_surface" android:gravity="end"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>