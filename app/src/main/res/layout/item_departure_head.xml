<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:paddingStart="20dp" android:paddingEnd="20dp"
    android:paddingTop="10dp" android:paddingBottom="6dp">
    <TextView android:layout_width="70dp" android:layout_height="wrap_content"
        android:text="Due" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/m3_on_surface_variant"/>
    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:text="Destination" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/m3_on_surface_variant"/>
    <TextView android:layout_width="80dp" android:layout_height="wrap_content"
        android:text="Status" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/m3_on_surface_variant"
        android:gravity="end"/>
    <TextView android:layout_width="64dp" android:layout_height="wrap_content"
        android:text="Plat" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/m3_on_surface_variant"
        android:gravity="end"/>
</LinearLayout>